schema card {
  document card {
    field language type string { indexing: "fr" | set_language }
    field card_id type string { indexing: summary }
    field title type string { indexing: summary | index
      index: enable-bm25 }
    field body type string { indexing: summary | index
      index: enable-bm25 }
    field source type string { indexing: summary }
    field corpus type string { indexing: summary | attribute }
    field revision type string { indexing: summary }
    field indexed_at type string { indexing: summary }
    field license type string { indexing: summary }
    field history type string { indexing: summary }
    field native_id type string { indexing: summary }
    field kind type string { indexing: summary }
    field structured_json type string { indexing: summary }
    field source_updated type string { indexing: summary }
    field fetched_at type string { indexing: summary }
  }
  fieldset default { fields: title, body }
  # Explicit defaults: baseline parameters, not empirically optimized values.
  rank-profile lexical {
    rank-properties {
      bm25(title).k1: 1.2
      bm25(title).b: 0.75
      bm25(body).k1: 1.2
      bm25(body).b: 0.75
    }
    first-phase { expression: 2 * bm25(title) + bm25(body) }
    summary-features { bm25(title) bm25(body) }
  }
  rank-profile lexical-balanced inherits lexical {
    first-phase { expression: bm25(title) + bm25(body) }
  }
  rank-profile lexical-title inherits lexical {
    first-phase { expression: 4 * bm25(title) + bm25(body) }
  }
  rank-profile lexical-saturated inherits lexical {
    first-phase { expression: 2 * bm25(title) / (8 + bm25(title)) + bm25(body) / (8 + bm25(body)) }
  }
  # Positional fieldMatch features are intentionally bounded to a second phase.
  rank-profile lexical-coverage inherits lexical {
    function query_coverage() {
      expression: max(fieldMatch(title).queryCompleteness, fieldMatch(body).queryCompleteness)
    }
    second-phase {
      expression: (2 * bm25(title) + bm25(body)) * (0.5 + 0.5 * query_coverage)
      rerank-count: 50
    }
    summary-features inherits lexical {
      query_coverage fieldMatch(title).queryCompleteness fieldMatch(body).queryCompleteness
    }
  }
  rank-profile lexical-proximity inherits lexical {
    function title_proximity() {
      expression: if(fieldMatch(title).matches > 1, fieldMatch(title).unweightedProximity * fieldMatch(title).relatedness * fieldMatch(title).queryCompleteness, 0)
    }
    function body_proximity() {
      expression: if(fieldMatch(body).matches > 1, fieldMatch(body).unweightedProximity * fieldMatch(body).relatedness * fieldMatch(body).queryCompleteness, 0)
    }
    second-phase {
      expression: 2 * bm25(title) + bm25(body) + 2 * title_proximity + body_proximity
      rerank-count: 50
    }
    summary-features inherits lexical {
      title_proximity body_proximity
      fieldMatch(title).matches fieldMatch(body).matches
      fieldMatch(title).unweightedProximity fieldMatch(body).unweightedProximity
      fieldMatch(title).relatedness fieldMatch(body).relatedness
      fieldMatch(title).queryCompleteness fieldMatch(body).queryCompleteness
    }
  }
}
